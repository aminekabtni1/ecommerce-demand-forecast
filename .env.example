# Copy to .env and fill values
# ------------------------------------------------------------------
# API
FAKESTORE_API_BASE=https://fakestoreapi.com
# Warehouse - DuckDB file path (relative to project root)
DUCKDB_PATH=data/warehouse.duckdb
# For future BigQuery/Snowflake swap:
# DB_TYPE=duckdb  # options: duckdb | bigquery | snowflake
# BIGQUERY_PROJECT=my-project
# BIGQUERY_DATASET=ecommerce
# SNOWFLAKE_ACCOUNT=xxx.us-east-1
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
VITE_API_BASE_URL=http://localhost:8000

# Prefect (optional - for Prefect Cloud)
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/xxx/workspaces/xxx
# PREFECT_API_KEY=pnu_xxx

# Forecasting
FORECAST_HORIZON_DAYS=30
FORECAST_CONFIDENCE=0.95
ANOMALY_Z_THRESHOLD=2.5
